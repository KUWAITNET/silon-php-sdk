{
    "name": "silon/silon-sdk",
    "description": "Official PHP SDK for the Silon messaging platform API — messaging, broadcasts, OTP, CRM, bulk, reports and webhooks.",
    "type": "library",
    "license": "MIT",
    "keywords": ["silon", "messaging", "whatsapp", "sms", "otp", "api", "sdk", "email", "push", "webhooks"],
    "homepage": "https://silon.tech",
    "authors": [
        {
            "name": "Silon",
            "homepage": "https://silon.tech"
        }
    ],
    "support": {
        "docs": "https://silon.tech/docs/",
        "issues": "https://github.com/KUWAITNET/silon-php-sdk/issues",
        "source": "https://github.com/KUWAITNET/silon-php-sdk"
    },
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Silon\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Silon\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
