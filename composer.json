{
    "name": "silon/silon-sdk",
    "description": "Official PHP SDK for the Silon messaging platform API — messaging, broadcasts, OTP, CRM, bulk, reports and webhooks.",
    "type": "library",
    "license": "MIT",
    "keywords": ["silon", "sdk", "api", "messaging", "whatsapp", "sms", "email", "push", "webhooks"],
    "homepage": "https://silon.tech",
    "authors": [
        { "name": "Silon" }
    ],
    "support": {
        "docs": "https://silon.tech/docs/"
    },
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-curl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Silon\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Silon\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
